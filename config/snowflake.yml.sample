# One section per TIOS_ENV. Generate the real file with bin/build-configs.sh.
# Auth is a key pair (priv_key_file) or a password; leave the other blank.
# There is no development Snowflake database, so every env reads TIOSDATA_PRODUCTION
# with the read-only TIOSREADER role.

readonly: &readonly
  username: youruser
  password:
  priv_key_file: ~/.ssh/snowflake-keys/snowflake_key.p8
  account_identifier: nta32714.us-east-1
  database: TIOSDATA_PRODUCTION
  schema: TIOSDATA
  warehouse: COMPUTE_WH
  role: TIOSREADER

development:
  <<: *readonly

production:
  <<: *readonly
